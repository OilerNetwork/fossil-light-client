# Use Ubuntu 24.04 (Noble Numbat) which has GLIBC 2.39
FROM ubuntu:noble

WORKDIR /app

# Install only the absolutely necessary runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /app/target/release/build/methods/out

# The binary and method ELFs will be copied during the build script
# using docker cp commands after the container is created

# Create wrapper script for ECS compatibility
RUN printf '%s\n' \
    '#!/bin/bash' \
    '' \
    '# Set IPFS environment variables' \
    'export IPFS_ADD_URL=https://ipfs.fossil.nethermind.dev/api/v0/add' \
    'export IPFS_FETCH_BASE_URL=https://ipfs.fossil.nethermind.dev/ipfs/' \
    'export IPFS_TOKEN=XvW7728X+u+fe1iPPR6yJYGyOUBEhAP3jCLK7AjI/TE=' \
    '' \
    '# If no arguments are provided, use smart defaults' \
    'if [ $# -eq 0 ]; then' \
    '    # Check if ENV_FILE exists and is readable' \
    '    if [ -n "${ENV_FILE:-}" ] && [ -f "${ENV_FILE}" ]; then' \
    '        exec /usr/local/bin/client --env-file "${ENV_FILE}" ${POLLING_INTERVAL:+--polling-interval $POLLING_INTERVAL} ${START_BLOCK:+--start-block $START_BLOCK} ${BATCH_SIZE:+--batch-size $BATCH_SIZE} ${STARKNET_MONITORING_START:+--starknet-monitoring-start $STARKNET_MONITORING_START}' \
    '    elif [ -f "/app/.env.docker" ]; then' \
    '        exec /usr/local/bin/client --env-file /app/.env.docker ${POLLING_INTERVAL:+--polling-interval $POLLING_INTERVAL} ${START_BLOCK:+--start-block $START_BLOCK} ${BATCH_SIZE:+--batch-size $BATCH_SIZE} ${STARKNET_MONITORING_START:+--starknet-monitoring-start $STARKNET_MONITORING_START}' \
    '    else' \
    '        # ECS mode - no env file, rely on environment variables, use /dev/null to avoid default .env lookup' \
    '        exec /usr/local/bin/client --env-file /dev/null ${POLLING_INTERVAL:+--polling-interval $POLLING_INTERVAL} ${START_BLOCK:+--start-block $START_BLOCK} ${BATCH_SIZE:+--batch-size $BATCH_SIZE} ${STARKNET_MONITORING_START:+--starknet-monitoring-start $STARKNET_MONITORING_START}' \
    '    fi' \
    'else' \
    '    # Arguments provided, pass them directly to client' \
    '    exec /usr/local/bin/client "$@"' \
    'fi' \
    > /usr/local/bin/client-wrapper.sh

RUN chmod +x /usr/local/bin/client-wrapper.sh

# Use ENTRYPOINT so it runs even with empty entrypoint/command arrays in ECS
ENTRYPOINT ["/usr/local/bin/client-wrapper.sh"]
