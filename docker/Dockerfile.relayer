# Stage 1: Build the application
FROM rust:alpine AS builder

# Set up the working directory
WORKDIR /app

# Install build dependencies including OpenSSL static libraries
RUN apk add --no-cache \
    musl-dev \
    git \
    openssl-dev \
    openssl-libs-static \
    pkgconfig \
    gcc

# Set environment variables for static linking
ENV OPENSSL_STATIC=1
ENV OPENSSL_LIB_DIR=/usr/lib
ENV OPENSSL_INCLUDE_DIR=/usr/include/openssl

# Copy Cargo.toml and Cargo.lock
COPY Cargo.toml Cargo.lock ./

# Copy all workspace crates and size-of-patch directory (required by workspace)
COPY crates ./crates
COPY size-of-patch ./size-of-patch

# Build only relayer
RUN cargo build --release --package relayer

# Stage 2: Create a minimal runtime image
FROM alpine:latest

WORKDIR /app

# Update repositories and install SSL certificates
RUN apk update && \
    apk add --no-cache ca-certificates openssl-dev bash

# Copy the compiled binary from the builder stage to /usr/local/bin
COPY --from=builder /app/target/release/relayer /usr/local/bin/relayer

# Make the binary executable
RUN chmod +x /usr/local/bin/relayer

# Create wrapper script for ECS compatibility
RUN printf '%s\n' \
    '#!/bin/bash' \
    '' \
    '# If no arguments are provided, use smart defaults' \
    'if [ $# -eq 0 ]; then' \
    '    # Check if ENV_FILE exists and is readable' \
    '    if [ -n "${ENV_FILE:-}" ] && [ -f "${ENV_FILE}" ]; then' \
    '        exec /usr/local/bin/relayer --env-file "${ENV_FILE}" ${RELAY_TIME_MINUTES:+--relay-time-minutes $RELAY_TIME_MINUTES} ${JSON_LOGS:+--json-logs} ${LOG_LEVEL:+--log-level $LOG_LEVEL} ${METRICS_ADDR:+--metrics-addr $METRICS_ADDR} ${NO_METRICS:+--no-metrics}' \
    '    elif [ -f "/app/.env.docker" ]; then' \
    '        exec /usr/local/bin/relayer --env-file /app/.env.docker ${RELAY_TIME_MINUTES:+--relay-time-minutes $RELAY_TIME_MINUTES} ${JSON_LOGS:+--json-logs} ${LOG_LEVEL:+--log-level $LOG_LEVEL} ${METRICS_ADDR:+--metrics-addr $METRICS_ADDR} ${NO_METRICS:+--no-metrics}' \
    '    else' \
    '        # ECS mode - no env file, rely on environment variables, use /dev/null to avoid default .env lookup' \
    '        exec /usr/local/bin/relayer --env-file /dev/null ${RELAY_TIME_MINUTES:+--relay-time-minutes $RELAY_TIME_MINUTES} ${JSON_LOGS:+--json-logs} ${LOG_LEVEL:+--log-level $LOG_LEVEL} ${METRICS_ADDR:+--metrics-addr $METRICS_ADDR} ${NO_METRICS:+--no-metrics}' \
    '    fi' \
    'else' \
    '    # Arguments provided, pass them directly to relayer' \
    '    exec /usr/local/bin/relayer "$@"' \
    'fi' \
    > /usr/local/bin/relayer-wrapper.sh

RUN chmod +x /usr/local/bin/relayer-wrapper.sh

# Use ENTRYPOINT so it runs even with empty entrypoint/command arrays in ECS
ENTRYPOINT ["/usr/local/bin/relayer-wrapper.sh"]
